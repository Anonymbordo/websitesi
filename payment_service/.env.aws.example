# Core database/auth/payment security
DATABASE_URL=postgresql://username:password@host:5432/database
SECRET_KEY=change-me
PAYMENT_SECURITY_SECRET=change-me-too

# Public URLs
PAYMENT_BASE_URL=https://pay.mikrokurs.com
PAYMENT_FRONTEND_BASE_URL=https://mikrokurs.com
PAYMENT_PUBLIC_BASE_URL=https://pay.mikrokurs.com

# Payment behavior
QNB_START_MODE=proxy
QNB_GATEWAY_URL=https://vpos.qnb.com.tr/Gateway/3DHost.aspx
QNB_OPERATION_GATEWAY_URL=https://vpos.qnb.com.tr/Gateway/Default.aspx
QNB_MBR_ID=5
QNB_MERCHANT_ID=
QNB_TERMINAL_ID=
QNB_USER_CODE=
QNB_USER_PASSWORD=
QNB_MERCHANT_PASS=
QNB_SECURE_TYPE=3DHost
QNB_TXN_TYPE=Auth
QNB_CURRENCY_CODE=949
QNB_LANGUAGE=tr
QNB_INSTALLMENT_COUNT=0
QNB_HASH_FIELD=Hash
QNB_HASH_TEMPLATE={mbr_id}{mrc_order_id}{amount}{ok_url}{fail_url}{txn_type}{installment_count}{rnd}{merchant_pass}
QNB_HASH_ALGORITHM=sha1
QNB_HASH_OUTPUT_ENCODING=base64
QNB_HASH_INPUT_ENCODING=ascii
QNB_HASH_UPPERCASE=false
QNB_FIELD_MAP_JSON={"mbr_id":"MbrId","merchant_id":"MerchantID","user_code":"UserCode","user_password":"UserPass","order_id":"OrderId","amount":"PurchAmount","currency":"Currency","ok_url":"OkUrl","fail_url":"FailUrl","lang":"Lang","secure_type":"SecureType","txn_type":"TxnType","installment_count":"InstallmentCount","rnd":"Rnd","hash":"Hash"}
QNB_EXTRA_FIELDS_JSON={}
QNB_SUCCESS_MATCH_JSON={"ProcReturnCode":"00"}
QNB_ECI_AUTH_LEVELS_JSON={"05":"full","02":"full","06":"half","01":"half"}
QNB_ORDER_ID_KEYS_JSON=["OrderId","MrcOrderId","MerchantOrderId","oid"]
QNB_REFERENCE_KEYS_JSON=["AuthCode","TransId","TransactionId","HostRefNum"]

# Network/security
CORS_ORIGINS=https://mikrokurs.com,https://www.mikrokurs.com,http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=pay.mikrokurs.com,mikrokurs.com,www.mikrokurs.com,localhost,127.0.0.1
CORS_ORIGIN_REGEX=https://.*\\.vercel\\.app
EXPOSE_INTERNAL_ERRORS=false
