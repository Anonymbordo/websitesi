# Copy this file to .env (or set real env vars in your deployment) and fill values. Do NOT commit real secrets.

# FastAPI / Twilio (SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+901234567890
DEFAULT_COUNTRY_CODE=90
DEV_SMS_FALLBACK=true

# Mailgun (optional)
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxx

# Gmail SMTP (optional)
GMAIL_USER=you@gmail.com
GMAIL_PASSWORD=your_app_password

# Core app
SECRET_KEY=your-super-secret-jwt-key-here-change-in-production
PAYMENT_SECURITY_SECRET=another-long-random-secret-for-payment-tokens
DATABASE_URL=postgresql://username:password@localhost/education_platform
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Firebase Admin (optional) - either JSON string or path
# FIREBASE_SERVICE_ACCOUNT='{"type": ... }'
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json

# AI Services
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# Email Service
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIRECTORY=uploads

# AWS S3 Settings
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_BUCKET_NAME=

# Payment base URL
# Production domain example: https://www.seninalanadin.com
PAYMENT_BASE_URL=
PAYMENT_FRONTEND_BASE_URL=http://localhost:3000

# QNB 3D Host Sanal POS
# Test: https://vpostest.qnb.com.tr/Gateway/3DHost.aspx
# Live: https://vpos.qnb.com.tr/Gateway/3DHost.aspx
QNB_GATEWAY_URL=https://vpostest.qnb.com.tr/Gateway/3DHost.aspx
# Refund/Void API gateway. If empty, it is derived from QNB_GATEWAY_URL as Default.aspx
QNB_OPERATION_GATEWAY_URL=https://vpostest.qnb.com.tr/Gateway/Default.aspx
QNB_MBR_ID=5
QNB_MERCHANT_ID=
QNB_TERMINAL_ID=
QNB_USER_CODE=
QNB_USER_PASSWORD=
QNB_MERCHANT_PASS=

# Gateway defaults
QNB_SECURE_TYPE=3DHost
QNB_TXN_TYPE=Auth
QNB_CURRENCY_CODE=949
QNB_LANGUAGE=TR
QNB_INSTALLMENT_COUNT=0

# 3D Host hash config
# Example template placeholders:
# {mbr_id} {mrc_order_id} {amount} {ok_url} {fail_url} {txn_type} {installment_count} {rnd} {merchant_pass}
QNB_HASH_FIELD=Hash
QNB_HASH_TEMPLATE={mbr_id}{mrc_order_id}{amount}{ok_url}{fail_url}{txn_type}{installment_count}{rnd}{merchant_pass}
QNB_HASH_ALGORITHM=sha1
QNB_HASH_OUTPUT_ENCODING=base64
QNB_HASH_INPUT_ENCODING=ascii
QNB_HASH_UPPERCASE=false

# If QNB documentation uses different parameter names, update this map instead of editing code.
QNB_FIELD_MAP_JSON={"mbr_id":"MbrId","merchant_id":"MerchantID","user_code":"UserCode","user_password":"UserPass","order_id":"OrderId","amount":"PurchAmount","currency":"Currency","ok_url":"OkUrl","fail_url":"FailUrl","lang":"Lang","secure_type":"SecureType","txn_type":"TxnType","installment_count":"InstallmentCount","rnd":"Rnd","hash":"Hash"}

# Extra gateway parameters from QNB docs, for example installment or store type
QNB_EXTRA_FIELDS_JSON={}

# Success matching rules for callback payload
QNB_SUCCESS_MATCH_JSON={"ProcReturnCode":"00"}
QNB_ECI_AUTH_LEVELS_JSON={"05":"full","02":"full","06":"half","01":"half"}
QNB_ORDER_ID_KEYS_JSON=["OrderId","MrcOrderId","MerchantOrderId","oid"]
QNB_REFERENCE_KEYS_JSON=["AuthCode","TransId","TransactionId","HostRefNum"]
